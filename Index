<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Facile En Vrai — Générateur</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;700;800&display=swap" rel="stylesheet">
<style>
  :root{--black:#000;--white:#fff;--orange:#FF6B00;--gray:#111;--gray2:#1a1a1a;--gray3:#2a2a2a;--green:#00ff88;--red:#ff3333}
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--black);color:var(--white);font-family:'Space Mono',monospace;min-height:100vh;padding:24px 16px;max-width:640px;margin:0 auto}
  header{text-align:center;margin-bottom:28px}
  header h1{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(24px,6vw,46px);letter-spacing:-1px}
  header h1 span{color:var(--orange)}
  header p{font-size:10px;color:#444;margin-top:5px;letter-spacing:2px;text-transform:uppercase}
  .card{background:var(--gray);border:1px solid var(--gray3);border-radius:12px;padding:18px;margin-bottom:14px}
  .ct{font-family:'Syne',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--orange);margin-bottom:12px}
  input[type=text],input[type=password],textarea,select{width:100%;background:var(--gray2);border:1px solid var(--gray3);border-radius:8px;color:var(--white);font-family:'Space Mono',monospace;font-size:13px;padding:11px 13px;outline:none;transition:border-color .2s;resize:vertical}
  input:focus,textarea:focus,select:focus{border-color:var(--orange)}
  textarea{min-height:68px;line-height:1.6}
  select{cursor:pointer}
  select option{background:#1a1a1a}
  .row{display:flex;gap:8px;align-items:stretch}
  .row input,.row select{flex:1}
  .btn{border:none;border-radius:8px;cursor:pointer;font-family:'Syne',sans-serif;font-weight:700;transition:all .18s;white-space:nowrap}
  .b-or{background:var(--orange);color:#000;font-size:13px;padding:11px 15px}
  .b-or:hover:not(:disabled){background:#ff8c33}
  .b-or:disabled{background:#333;color:#555;cursor:not-allowed}
  .b-ghost{background:var(--gray2);border:1px solid var(--gray3);color:#888;font-size:12px;padding:9px 13px}
  .b-ghost:hover{border-color:var(--orange);color:var(--orange)}
  .b-del{background:none;border:1px solid var(--gray3);border-radius:6px;color:#555;cursor:pointer;font-size:14px;padding:6px 10px;transition:all .15s;margin-top:5px;flex-shrink:0}
  .b-del:hover{border-color:var(--red);color:var(--red)}
  .b-add{width:100%;background:none;border:1px dashed var(--gray3);border-radius:8px;color:#444;cursor:pointer;font-family:'Space Mono',monospace;font-size:12px;padding:10px;transition:all .2s;margin-top:6px}
  .b-add:hover{border-color:var(--orange);color:var(--orange)}
  .b-gen{width:100%;background:var(--orange);border:none;border-radius:10px;color:#000;cursor:pointer;font-family:'Syne',sans-serif;font-weight:800;font-size:16px;letter-spacing:1px;padding:18px;text-transform:uppercase;transition:all .2s;margin-bottom:14px}
  .b-gen:hover:not(:disabled){background:#ff8c33;transform:translateY(-1px)}
  .b-gen:disabled{background:#222;color:#444;cursor:not-allowed;transform:none}
  .tag{font-size:11px;margin-top:8px;padding:8px 10px;border-radius:6px;display:none;line-height:1.5}
  .t-load{background:#ff6b0015;color:var(--orange);border:1px solid #ff6b0030;display:block}
  .t-ok{background:#00ff8815;color:var(--green);border:1px solid #00ff8830;display:block}
  .t-err{background:#ff333315;color:var(--red);border:1px solid #ff333330;display:block}
  .r2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
  .fl{font-size:10px;color:#555;text-transform:uppercase;letter-spacing:1px;margin-bottom:5px;margin-top:10px}
  .note{font-size:11px;color:#444;margin-top:7px;line-height:1.6}
  .note a{color:var(--orange);text-decoration:none}
  
  /* Model grid */
  .model-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}
  .model-btn{background:var(--gray2);border:1px solid var(--gray3);border-radius:8px;padding:10px 12px;cursor:pointer;transition:all .15s;text-align:left}
  .model-btn:hover{border-color:#555}
  .model-btn.selected{border-color:var(--orange);background:#ff6b0010}
  .model-btn .mname{font-family:'Syne',sans-serif;font-weight:700;font-size:12px;color:var(--white)}
  .model-btn .mdesc{font-size:10px;color:#555;margin-top:3px;line-height:1.4}
  .model-btn .mbadge{font-size:9px;background:var(--orange);color:#000;border-radius:3px;padding:1px 5px;display:inline-block;margin-bottom:4px;font-weight:700}
  .model-btn .mbadge.free{background:#00ff88;color:#000}
  .model-btn .mbadge.tokens{background:#ffaa00;color:#000}

  /* Image reference */
  .ref-zone{border:2px dashed var(--gray3);border-radius:10px;padding:16px;text-align:center;cursor:pointer;transition:all .2s;position:relative;margin-top:4px}
  .ref-zone:hover{border-color:var(--orange)}
  .ref-zone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
  .ref-zone p{font-size:12px;color:#555;pointer-events:none}
  .ref-preview{display:none;position:relative;margin-top:8px}
  .ref-preview img{width:80px;height:120px;object-fit:cover;border-radius:6px;border:1px solid var(--gray3)}
  .ref-preview .ref-remove{position:absolute;top:-6px;left:68px;background:var(--red);border:none;border-radius:50%;color:#fff;cursor:pointer;font-size:12px;width:20px;height:20px;display:flex;align-items:center;justify-content:center}
  .strength-row{display:flex;gap:6px;margin-top:8px}
  .strength-btn{flex:1;background:var(--gray2);border:1px solid var(--gray3);border-radius:6px;color:#666;cursor:pointer;font-family:'Space Mono',monospace;font-size:11px;padding:7px;text-align:center;transition:all .15s}
  .strength-btn.sel{border-color:var(--orange);color:var(--orange);background:#ff6b0010}

  /* Prompts */
  .pc{display:flex;flex-direction:column;gap:10px}
  .pr{display:flex;gap:8px;align-items:flex-start}
  .pn{font-family:'Syne',sans-serif;font-weight:800;font-size:13px;color:var(--orange);min-width:22px;padding-top:12px;flex-shrink:0}
  .pr textarea{flex:1;min-height:65px}

  /* Progress */
  .prog-wrap{background:var(--gray2);border-radius:4px;height:3px;overflow:hidden;margin-bottom:14px;display:none}
  .prog-bar{background:var(--orange);height:100%;border-radius:4px;transition:width .4s;width:0%}

  /* Results */
  .rg{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  .ri{background:var(--gray2);border:1px solid var(--gray3);border-radius:10px;overflow:hidden;position:relative}
  .ri img{width:100%;display:block;aspect-ratio:9/16;object-fit:cover}
  .ph{width:100%;aspect-ratio:9/16;background:var(--gray3);display:flex;align-items:center;justify-content:center}
  .rl{font-size:10px;color:#444;padding:6px 8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rs{position:absolute;top:7px;right:7px;font-size:9px;padding:3px 6px;border-radius:4px;font-weight:700}
  .sp{background:#222;color:#555}.sg{background:#ff6b0020;color:var(--orange);border:1px solid var(--orange)}.sd{background:#00ff8820;color:var(--green);border:1px solid var(--green)}.se{background:#ff333320;color:var(--red);border:1px solid var(--red)}
  .spinner{width:18px;height:18px;border:2px solid #333;border-top-color:var(--orange);border-radius:50%;animation:spin .8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  .rdl{display:block;width:calc(100% - 12px);margin:0 6px 6px;background:var(--gray3);border:none;border-radius:5px;color:#777;cursor:pointer;font-family:'Space Mono',monospace;font-size:10px;padding:6px;text-align:center;transition:all .15s;text-decoration:none}
  .rdl:hover{background:var(--orange);color:#000}
  .b-dl-all{width:100%;background:var(--gray2);border:1px solid var(--green);border-radius:10px;color:var(--green);cursor:pointer;font-family:'Syne',sans-serif;font-weight:700;font-size:14px;padding:14px;text-transform:uppercase;letter-spacing:1px;margin-top:14px;transition:all .2s;display:none}
  .b-dl-all:hover{background:#00ff8810}
  .log{font-size:10px;color:#444;line-height:1.9;margin-top:10px;max-height:90px;overflow-y:auto}
  .lok{color:var(--green)}.lerr{color:var(--red)}.linfo{color:var(--orange)}
  #res{display:none}
</style>
</head>
<body>

<header>
  <h1>FACILE <span>EN VRAI</span></h1>
  <p>Générateur automatique — Leonardo AI</p>
</header>

<!-- STEP 1: API KEY -->
<div class="card">
  <div class="ct">① Clé API Leonardo</div>
  <div class="row">
    <input type="password" id="apiKey" placeholder="Colle ta clé API ici..." />
    <button class="btn b-or" id="loadBtn" onclick="loadModels()">Vérifier</button>
  </div>
  <div class="tag" id="apiTag"></div>
  <p class="note">→ <a href="https://app.leonardo.ai/" target="_blank">app.leonardo.ai</a> — API Access — Create New Key</p>
</div>

<!-- STEP 2: MODEL -->
<div class="card">
  <div class="ct">② Modèle</div>
  <div class="model-grid" id="modelGrid">
    <!-- populated by JS -->
  </div>
  <input type="hidden" id="selectedModel" value="nano-banana-2" />
  <div class="r2">
    <div><div class="fl">Largeur</div><input type="text" id="imgW" value="768"/></div>
    <div><div class="fl">Hauteur</div><input type="text" id="imgH" value="1376"/></div>
  </div>
  <div class="fl">Qualité</div>
  <select id="quality">
    <option value="MEDIUM">Medium (recommandé)</option>
    <option value="LOW">Low (plus rapide)</option>
    <option value="HIGH">High (meilleure qualité)</option>
  </select>
  <p class="note" style="margin-top:6px">576×1024 = 9:16 TikTok ✓ — Nano Banana ne supporte pas encore le 9:16 nativement, utilise 720×1280 ou 1024×1024</p>
</div>

<!-- STEP 3: IMAGE DE RÉFÉRENCE -->
<div class="card">
  <div class="ct">③ Image de référence (optionnel)</div>
  <p class="note" style="margin-bottom:10px">
    1. Va sur <a href="https://app.leonardo.ai" target="_blank">app.leonardo.ai</a><br>
    2. Clique l'icône image dans la barre de prompt → Upload ton perso<br>
    3. Clique sur l'image uploadée → copie l'<strong style="color:var(--orange)">ID</strong> dans l'URL ou les détails<br>
    4. Colle-le ici ↓
  </p>
  <input type="text" id="refImageId" placeholder="Ex: 1e2abd31-ee5a-4e2d-a724-0625c50e4c7e" />
  <div class="fl" style="margin-top:8px">Type d'image</div>
  <div class="strength-row" style="margin-top:4px">
    <button class="strength-btn" id="typeGenerated" onclick="setRefType('GENERATED', this)">Générée sur Leonardo</button>
    <button class="strength-btn sel" id="typeUploaded" onclick="setRefType('UPLOADED', this)">Uploadée</button>
  </div>
  <div id="strengthWrap" style="margin-top:10px">
    <div class="fl">Force de la référence</div>
    <div class="strength-row">
      <button class="strength-btn" onclick="setStrength('LOW', this)">Faible</button>
      <button class="strength-btn sel" onclick="setStrength('MID', this)">Moyenne</button>
      <button class="strength-btn" onclick="setStrength('HIGH', this)">Forte</button>
    </div>
  </div>
</div>

<!-- STEP 4: PROMPTS -->
<div class="card">
  <div class="ct">④ Tes prompts</div>
  <div class="pc" id="pc"></div>
  <button class="b-add" onclick="addPrompt()">+ Ajouter un prompt</button>
</div>

<!-- GENERATE -->
<button class="b-gen" id="genBtn" onclick="startGen()">⚡ Générer toutes les images</button>

<div class="prog-wrap" id="progWrap">
  <div class="prog-bar" id="progBar"></div>
</div>

<!-- RESULTS -->
<div id="res">
  <div class="card">
    <div class="ct">📋 Journal</div>
    <div class="log" id="logEl"></div>
  </div>
  <div class="rg" id="rg"></div>
  <button class="b-dl-all" id="dlAllBtn" onclick="dlAll()">⬇ Télécharger toutes les images</button>
</div>

<script>
// ─── STATE ───────────────────────────────────────────────
let selectedModel = 'nano-banana-2';
let refImageId = null;
let refStrength = 'MID';
let imgRefType = 'UPLOADED';
let generatedImages = [];
let refBase64 = null;

// ─── MODELS ──────────────────────────────────────────────
const MODELS = [
  { id:'nano-banana-2',   name:'Nano Banana 2', badge:'NEW', badgeClass:'', desc:'Google Gemini 3 Flash — meilleur pour cartoon', api:'v2' },
  { id:'gpt-image-2',     name:'GPT Image 2',   badge:'NEW', badgeClass:'', desc:'OpenAI — qualité max, texte parfait', api:'v2' },
  { id:'nano-banana',     name:'Nano Banana',    badge:'TOKENS', badgeClass:'tokens', desc:'Google Gemini Flash — édition précise', api:'v2' },
  { id:'gpt-image-1.5',   name:'GPT Image 1.5', badge:'TOKENS', badgeClass:'tokens', desc:'OpenAI — édition avancée', api:'v2' },
  { id:'lucid-origin',    name:'Lucid Origin',   badge:'GRATUIT', badgeClass:'free', desc:'Leonardo — illimité en relaxed', api:'v2' },
  { id:'flux-schnell',    name:'FLUX Schnell',   badge:'RAPIDE', badgeClass:'free', desc:'Rapide, bonne qualité', api:'v2' },
  { id:'phoenix-1.0',     name:'Phoenix 1.0',    badge:'GRATUIT', badgeClass:'free', desc:'Leonardo — texte + prompt adherence', api:'v2' },
  { id:'ideogram-3.0',    name:'Ideogram 3.0',   badge:'TOKENS', badgeClass:'tokens', desc:'Spécialiste texte dans les images', api:'v2' },
];

function buildModelGrid() {
  const grid = document.getElementById('modelGrid');
  grid.innerHTML = '';
  MODELS.forEach(m => {
    const btn = document.createElement('div');
    btn.className = 'model-btn' + (m.id === selectedModel ? ' selected' : '');
    btn.onclick = () => selectModel(m.id);
    btn.innerHTML = `<div class="mbadge ${m.badgeClass}">${m.badge}</div><div class="mname">${m.name}</div><div class="mdesc">${m.desc}</div>`;
    grid.appendChild(btn);
  });
}

function selectModel(id) {
  selectedModel = id;
  document.getElementById('selectedModel').value = id;
  document.querySelectorAll('.model-btn').forEach((btn, i) => {
    btn.classList.toggle('selected', MODELS[i].id === id);
  });
}

// ─── API KEY CHECK ────────────────────────────────────────
async function loadModels() {
  const apiKey = document.getElementById('apiKey').value.trim();
  if (!apiKey) { alert('Entre ta clé API !'); return; }
  const tag = document.getElementById('apiTag');
  const btn = document.getElementById('loadBtn');
  btn.disabled = true;
  tag.className = 'tag t-load';
  tag.textContent = '⏳ Vérification...';
  try {
    const res = await fetch('https://cloud.leonardo.ai/api/rest/v1/me', {
      headers: { 'accept': 'application/json', 'authorization': `Bearer ${apiKey}` }
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.message || `HTTP ${res.status}`);
    const user = data.user_details?.[0];
    const tokens = user?.tokenRenewalDate ? '' : '';
    tag.className = 'tag t-ok';
    tag.textContent = `✓ Connecté — ${user?.username || 'OK'} — Solde : ${user?.apiCredit ?? '?'} crédits API`;
  } catch(e) {
    tag.className = 'tag t-err';
    tag.textContent = `✗ ${e.message}`;
  }
  btn.disabled = false;
}

// ─── IMAGE REFERENCE ──────────────────────────────────────
function handleRefImage(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    refBase64 = ev.target.result.split(',')[1];
    document.getElementById('refImg').src = ev.target.result;
    document.getElementById('refPreview').style.display = 'block';
    document.getElementById('strengthWrap').style.display = 'block';
    document.getElementById('refZone').style.display = 'none';
  };
  reader.readAsDataURL(file);
}

function removeRef() {
  refBase64 = null;
  refImageId = null;
  document.getElementById('refPreview').style.display = 'none';
  document.getElementById('strengthWrap').style.display = 'none';
  document.getElementById('refZone').style.display = 'block';
  document.getElementById('refInput').value = '';
}

function setStrength(val, el) {
  refStrength = val;
  // Only toggle within same group
  el.closest('.strength-row').querySelectorAll('.strength-btn').forEach(b => b.classList.remove('sel'));
  el.classList.add('sel');
}

function setRefType(val, el) {
  imgRefType = val;
  el.closest('.strength-row').querySelectorAll('.strength-btn').forEach(b => b.classList.remove('sel'));
  el.classList.add('sel');
}

// ─── UPLOAD REF IMAGE ────────────────────────────────────
async function uploadRefImage(apiKey) {
  // Step 1: get upload URL
  const ext = 'png';
  const initRes = await fetch('https://cloud.leonardo.ai/api/rest/v1/init-image', {
    method: 'POST',
    headers: { 'accept': 'application/json', 'authorization': `Bearer ${apiKey}`, 'content-type': 'application/json' },
    body: JSON.stringify({ extension: ext })
  });
  const initData = await initRes.json();
  if (!initRes.ok) throw new Error('Upload init échoué: ' + JSON.stringify(initData));

  const uploadUrl = initData.uploadInitImage?.url;
  const imageId = initData.uploadInitImage?.id;
  const fields = initData.uploadInitImage?.fields;

  // Step 2: upload to S3
  const formData = new FormData();
  Object.entries(JSON.parse(fields)).forEach(([k,v]) => formData.append(k, v));
  const blob = await (await fetch(`data:image/png;base64,${refBase64}`)).blob();
  formData.append('file', blob, 'reference.png');

  await fetch(uploadUrl, { method: 'POST', body: formData });
  return imageId;
}

// ─── PROMPTS ──────────────────────────────────────────────
const DEFAULT_PROMPTS = [
  "flat 2D cartoon illustration, vertical 9:16, bold thick black outlines, solid pure black background, no gradients no textures, single orange humanoid character, round smooth orange head, large white oval eyes, no mouth no nose, black sleeveless shirt, black shorts, bare orange feet, sitting slumped exhausted at small wooden desk, head drooping, crossed-out calendar on wall, full body visible head to toe, Pink Panther cartoon style, vector art",
  "flat 2D cartoon illustration, vertical 9:16, bold thick black outlines, solid pure black background, no gradients no textures, single orange humanoid character, round smooth orange head, large white oval eyes, no mouth no nose, black sleeveless shirt, black shorts, bare orange feet, standing confident, both open hands with green money bills floating around, full body visible, Pink Panther cartoon style, vector art",
  "flat 2D cartoon illustration, vertical 9:16, bold thick black outlines, solid pure black background, no gradients no textures, single orange humanoid character, round smooth orange head, large white oval eyes, no mouth no nose, black sleeveless shirt, black shorts, bare orange feet, pointing proudly at giant green bar chart, excited pose, full body visible, Pink Panther cartoon style, vector art",
  "flat 2D cartoon illustration, vertical 9:16, bold thick black outlines, solid pure black background, no gradients no textures, single orange humanoid character, round smooth orange head, large white oval eyes, no mouth no nose, black sleeveless shirt, black shorts, bare orange feet, sprinting forward, motion lines behind, fist forward, full body visible, Pink Panther cartoon style, vector art"
];

function addPrompt(text='') {
  const c = document.getElementById('pc');
  const i = c.children.length + 1;
  const row = document.createElement('div');
  row.className = 'pr';
  row.innerHTML = `<span class="pn">${i}</span><textarea placeholder="Ton prompt...">${text}</textarea><button class="b-del" onclick="removePrompt(this)">✕</button>`;
  c.appendChild(row);
  updateNums();
}
function removePrompt(btn) { btn.closest('.pr').remove(); updateNums(); }
function updateNums() { document.querySelectorAll('.pn').forEach((el,i) => el.textContent = i+1); }
function getPrompts() { return Array.from(document.querySelectorAll('.pc textarea')).map(t=>t.value.trim()).filter(Boolean); }

// ─── GENERATION ───────────────────────────────────────────
function log(msg, type='info') {
  const el = document.getElementById('logEl');
  const d = document.createElement('div');
  d.className = type==='ok'?'lok':type==='err'?'lerr':'linfo';
  d.textContent = `> ${msg}`;
  el.appendChild(d);
  el.scrollTop = el.scrollHeight;
}

function setProgress(cur, total) {
  document.getElementById('progBar').style.width = total ? (cur/total*100)+'%' : '0%';
}

// V2 API polling
async function pollV2(apiKey, genId) {
  for (let i=0; i<40; i++) {
    await new Promise(r=>setTimeout(r,2500));
    try {
      // v2 n'a pas d'endpoint GET — on poll via v1
      const res = await fetch(`https://cloud.leonardo.ai/api/rest/v1/generations/${genId}`, {
        headers:{'accept':'application/json','authorization':`Bearer ${apiKey}`}
      });
      const data = await res.json();
      console.log('V2 POLL response:', JSON.stringify(data));
      // v2 response shape - try all possible structures
      console.log('POLL raw:', JSON.stringify(data));
      const gen = data.generate || data.generation || data.generations_by_pk || data;
      const status = gen.status || gen.generationStatus;
      const imgs = gen.generated_images || gen.generatedImages || gen.images || [];
      if ((status === 'COMPLETE' || status === 'complete') && imgs.length) {
        return imgs[0].url || imgs[0].imageUrl || imgs[0].image_url;
      }
      if (status === 'FAILED' || status === 'failed') return null;
    } catch(e){}
  }
  return null;
}

async function genImageV2(apiKey, prompt, model, w, h, quality, imgRefId) {
  const body = {
    model,
    public: false,
    parameters: {
      prompt,
      width: parseInt(w),
      height: parseInt(h),
      quantity: 1,
      quality: quality,
      prompt_enhance: 'OFF',
    }
  };

  // Add image reference if provided
  if (imgRefId) {
    body.parameters.guidances = {
      image_reference: [{
        image: { id: imgRefId, type: imgRefType },
        strength: refStrength
      }]
    };
  }

  const res = await fetch('https://cloud.leonardo.ai/api/rest/v2/generations', {
    method: 'POST',
    headers: { 'accept':'application/json', 'authorization':`Bearer ${apiKey}`, 'content-type':'application/json' },
    body: JSON.stringify(body)
  });
  const data = await res.json();
  console.log('V2 POST response:', JSON.stringify(data));
  if (!res.ok) throw new Error(JSON.stringify(data).slice(0, 200));
  // Try all possible fields where generationId could be
  const genId = data.generationId
    || data.id
    || data.generate?.generationId
    || data.generate?.id
    || data.generation?.id
    || data.generation?.generationId
    || data.sdGenerationJob?.generationId
    || data.data?.generationId
    || data.data?.id;
  if (!genId) throw new Error('Réponse inattendue: ' + JSON.stringify(data).slice(0, 200));
  return genId;
}

async function startGen() {
  const apiKey = document.getElementById('apiKey').value.trim();
  const model = selectedModel;
  const w = document.getElementById('imgW').value;
  const h = document.getElementById('imgH').value;
  const quality = document.getElementById('quality').value;
  const prompts = getPrompts();

  if (!apiKey) { alert('Entre ta clé API !'); return; }
  if (!prompts.length) { alert('Ajoute au moins un prompt !'); return; }

  generatedImages = [];
  document.getElementById('res').style.display = 'block';
  document.getElementById('logEl').innerHTML = '';
  document.getElementById('dlAllBtn').style.display = 'none';
  document.getElementById('progWrap').style.display = 'block';
  document.getElementById('genBtn').disabled = true;
  setProgress(0, prompts.length);

  const grid = document.getElementById('rg');
  grid.innerHTML = '';
  prompts.forEach((p,i) => {
    const item = document.createElement('div');
    item.className='ri'; item.id=`ri${i}`;
    item.innerHTML=`<div class="ph"><div class="spinner"></div></div><span class="rs sp" id="rs${i}">ATTENTE</span><div class="rl">${i+1}. ${p.slice(0,40)}...</div>`;
    grid.appendChild(item);
  });

  // Use image ID directly
  const refIdInput = document.getElementById('refImageId').value.trim();
  const uploadedRefId = refIdInput || null;
  if (uploadedRefId) {
    log(`Image de référence : ${uploadedRefId.slice(0,8)}... (force: ${refStrength})`, 'info');
  }

  log(`Modèle : ${model} — ${prompts.length} image(s)`, 'info');

  for (let i=0; i<prompts.length; i++) {
    const item = document.getElementById(`ri${i}`);
    const rs = document.getElementById(`rs${i}`);
    rs.className='rs sg'; rs.textContent='GÉN...';
    log(`Image ${i+1}/${prompts.length}...`);
    try {
      const genId = await genImageV2(apiKey, prompts[i], model, w, h, quality, uploadedRefId);
      if (!genId) throw new Error('Pas de generationId');
      log(`Image ${i+1} — polling résultat...`);
      const url = await pollV2(apiKey, genId);
      if (url) {
        item.querySelector('.ph').remove();
        const img = document.createElement('img');
        img.src = url;
        item.insertBefore(img, rs);
        const dl = document.createElement('a');
        dl.href=url; dl.target='_blank'; dl.className='rdl'; dl.textContent='⬇ Ouvrir';
        item.appendChild(dl);
        rs.className='rs sd'; rs.textContent='PRÊT';
        generatedImages.push(url);
        log(`Image ${i+1} ✓`, 'ok');
      } else throw new Error('Timeout / génération échouée');
    } catch(e) {
      rs.className='rs se'; rs.textContent='ERR';
      item.querySelector('.ph').innerHTML='<span style="color:#ff3333;font-size:22px">✗</span>';
      log(`Image ${i+1} erreur : ${e.message}`, 'err');
    }
    setProgress(i+1, prompts.length);
  }

  document.getElementById('genBtn').disabled = false;
  if (generatedImages.length) document.getElementById('dlAllBtn').style.display = 'block';
  log(`Terminé ! ${generatedImages.length}/${prompts.length} images.`, 'ok');
}

function dlAll() {
  generatedImages.forEach((url,i) => {
    const a = document.createElement('a');
    a.href=url; a.target='_blank'; a.download=`facile-en-vrai-${i+1}.jpg`;
    a.click();
  });
}

// ─── INIT ─────────────────────────────────────────────────
buildModelGrid();
DEFAULT_PROMPTS.forEach(p => addPrompt(p));
</script>
